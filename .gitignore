*.bak.*
.DS_Store
.pytest_cache/
__pycache__/
*.py[cod]
# Everything Claude Code writes here is per-machine state. The enumerated list
# that used to sit below went stale as new files appeared (.last_inuse_sweep),
# which is how machine state nearly reached a public repo — so ignore the
# directory itself. The installer does not link it: ~/.claude/plugins is a
# manual symlink to this folder (see the harnesses.toml header).
plugins/

# Local skill-sync state (written per-machine by the sync tool)
skills/.sync-manifest.json

# Machine-local skill; keep the repo copy out of version control.
skills/omarchy

# Claude account skills synced per machine (Anthropic-licensed, not ours to publish).
skills/synced/
# Synced skills Claude Code retires land here until cleanup; same license as above.
skills/.trash/

# Stray lockfiles from npm runs. progressive-web is the only package, and its own .gitignore keeps its lockfile tracked.
package-lock.json

# Skills other tools install on this machine and link in here.
skills/hey
skills/twg*
