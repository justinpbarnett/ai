# Everything Claude Code writes here is per-machine state. The enumerated list
# that used to sit below went stale as new files appeared (.last_inuse_sweep),
# which is how machine state nearly reached a public repo — so ignore the
# directory itself.
plugins/

# Local skill-sync state (written per-machine by the sync tool)
skills/.sync-manifest.json

# Machine-local skill; keep the repo copy out of version control.
skills/omarchy

# Claude account skills synced per machine (Anthropic-licensed, not ours to publish).
skills/synced/
